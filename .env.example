# Optional settings for the local dev server. Copy this file to .env.local and restart `npm run dev`.
# Values are only read by the local dev server; they are never sent to the browser.

# "Claude Code" generation (default): only needed when the `claude` command is not on your PATH.
CLAUDE_CODE_PATH=

# "Claude (Anthropic API)" generation: your Anthropic API key.
ANTHROPIC_API_KEY=

# "snapp usecase": import pages by link and publish updates back to Confluence.
# Create a Personal Access Token in Confluence (Profile → Personal Access Tokens) and paste it here.
CONFLUENCE_BASE_URL=https://confluence.snappfood.ir
CONFLUENCE_TOKEN=
